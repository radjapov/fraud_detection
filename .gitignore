# .gitignore (пример)
__pycache__/
*.pyc
.venv/
venv/
.env
.DS_Store
.idea/
.vscode/

# data & artifacts (do NOT commit raw datasets/models)
data/
artifacts/
*.joblib
*.pkl
*.h5
# Raw IEEE-CIS dataset (too large for GitHub)
data/ieee/train_transaction.csv
data/ieee/train_identity.csv
data/ieee/test_transaction.csv
data/ieee/sample_submission.csv

# Local stuff
artifacts/history.json
artifacts/shap_input.json

# experiment outputs (pipelines, Optuna studies, per-seed scores, figures): ~400 MB.
# Reproduce with experiments/run_all.sh, then experiments/make_figures.py for the tables / figures.
runs/*
# !runs/paper/   <- uncomment to track the small (~1 MB) paper tables and figures
